<main id="main">

  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href="index.html">Home</a> / Booking Request</p>
      <h1>Booking Request</h1>
      <p style="max-width:600px; color:#cfd6dc; margin-top:0.6rem;">This form sends a booking request — it does not confirm a reservation. Our team will contact you to confirm availability and finalize your stay.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="form-card reveal" style="max-width:820px; margin:0 auto;">
        <form id="booking-form" novalidate>
          <div class="form-grid">
            <div class="form-field">
              <label for="b-name">Full Name</label>
              <input type="text" id="b-name" name="name" required>
              <span class="field-error">Please enter your full name.</span>
            </div>
            <div class="form-field">
              <label for="b-email">Email</label>
              <input type="email" id="b-email" name="email" required>
              <span class="field-error">Please enter a valid email address.</span>
            </div>
            <div class="form-field">
              <label for="b-phone">Phone</label>
              <input type="tel" id="b-phone" name="phone" required>
              <span class="field-error">Please enter a valid phone number.</span>
            </div>
            <div class="form-field">
              <label for="b-roomtype">Room Type</label>
              <select id="b-roomtype" name="roomtype" required>
                <option value="">Select a room type</option>
                <option>Standard Room</option>
                <option>Deluxe Room</option>
                <option>Executive Room</option>
                <option>Royal Suite</option>
              </select>
              <span class="field-error">Please select a room type.</span>
            </div>
            <div class="form-field">
              <label for="b-checkin">Check-in Date</label>
              <input type="date" id="b-checkin" name="checkin" required>
              <span class="field-error">Please choose a valid check-in date.</span>
            </div>
            <div class="form-field">
              <label for="b-checkout">Check-out Date</label>
              <input type="date" id="b-checkout" name="checkout" required>
              <span class="field-error">Check-out must be after check-in.</span>
            </div>
            <div class="form-field">
              <label for="b-adults">Adults</label>
              <select id="b-adults" name="adults">
                <option>1</option><option selected>2</option><option>3</option><option>4</option><option>5+</option>
              </select>
            </div>
            <div class="form-field">
              <label for="b-children">Children</label>
              <select id="b-children" name="children">
                <option selected>0</option><option>1</option><option>2</option><option>3+</option>
              </select>
            </div>
            <div class="form-field full">
              <label for="b-requests">Special Requests</label>
              <textarea id="b-requests" name="requests" placeholder="Optional — let us know anything else we should be aware of."></textarea>
            </div>
          </div>

          <button type="submit" class="btn btn-gold btn-block">Send Booking Request</button>

          <div class="form-success" role="status">
            <strong>Booking Request Received</strong>
            Thank you — your booking request has been prepared. This is a request only; no room is reserved until our team confirms availability with you.
            <div class="booking-ref-box" id="booking-reference"></div>
            <a href="#" id="booking-whatsapp-btn" class="btn btn-whatsapp" style="display:none; margin-top:1rem;"><i class="fa-brands fa-whatsapp"></i> Send Request via WhatsApp</a>
          </div>
        </form>
      </div>
    </div>
  </section>

