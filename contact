<main id="main">

  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href="index.html">Home</a> / Contact</p>
      <h1>Contact Us</h1>
    </div>
  </section>

  <section>
    <div class="container two-col">

      <div class="reveal">
        <span class="section-eyebrow">Get in Touch</span>
        <h2>We'd love to hear from you</h2>
        <p style="margin-top:0.7rem; color:var(--color-text-muted);">Reach out with any questions about rooms, events or your upcoming stay in Kabba.</p>

        <div class="contact-info-list">
          <div class="ci-item">
            <div class="ci-icon"><i class="fa-solid fa-location-dot"></i></div>
            <div>
              <h4>Address</h4>
              <p>Golden Grand Royal Hotel, Kabba, Kogi State, Nigeria</p>
            </div>
          </div>
          <div class="ci-item">
            <div class="ci-icon"><i class="fa-solid fa-phone"></i></div>
            <div>
              <h4>Phone</h4>
              <p><a href="tel:+2348145703890">0814 570 3890</a><br>
              <a href="tel:+2348112165602">0811 216 5602</a><br>
              <a href="tel:+2348112165601">0811 216 5601</a></p>
            </div>
          </div>
          <div class="ci-item">
            <div class="ci-icon"><i class="fa-brands fa-whatsapp"></i></div>
            <div>
              <h4>WhatsApp</h4>
              <p><a href="#" data-whatsapp="Hello Golden Grand Royal Hotel, I would like to make an enquiry.">Chat with us instantly</a></p>
            </div>
          </div>
        </div>

        <a href="#" class="btn btn-whatsapp" style="margin-top:1.5rem;" data-whatsapp="Hello Golden Grand Royal Hotel, I would like to make an enquiry."><i class="fa-brands fa-whatsapp"></i> Chat on WhatsApp</a>
      </div>

      <div class="form-card reveal">
        <h3 style="margin-bottom:1.2rem;">Send Us a Message</h3>
        <form id="contact-form" novalidate>
          <div class="form-field">
            <label for="c-name">Full Name</label>
            <input type="text" id="c-name" name="name" required>
            <span class="field-error">Please enter your name.</span>
          </div>
          <div class="form-field">
            <label for="c-email">Email</label>
            <input type="email" id="c-email" name="email" required>
            <span class="field-error">Please enter a valid email address.</span>
          </div>
          <div class="form-field">
            <label for="c-phone">Phone</label>
            <input type="tel" id="c-phone" name="phone" required>
            <span class="field-error">Please enter your phone number.</span>
          </div>
          <div class="form-field">
            <label for="c-subject">Subject</label>
            <input type="text" id="c-subject" name="subject">
          </div>
          <div class="form-field">
            <label for="c-message">Message</label>
            <textarea id="c-message" name="message" required></textarea>
            <span class="field-error">Please enter your message.</span>
          </div>
          <button type="submit" class="btn btn-navy btn-block">Send Message</button>

          <div class="form-success" role="status">
            <strong>Message sent</strong>
            Thank you for reaching out. Our team will get back to you shortly — for a faster response, you can also chat with us on WhatsApp.
          </div>
        </form>
      </div>

    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="section-head center reveal">
        <span class="section-eyebrow">Find Us</span>
        <h2>Golden Grand Royal Hotel, Kabba</h2>
      </div>
      <div class="map-embed reveal">
        <iframe
          src="https://www.google.com/maps?q=Golden+Grand+Royal+Hotel,+Kabba,+Kogi+State,+Nigeria&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Map showing Golden Grand Royal Hotel, Kabba, Kogi State">
        </iframe>
      </div>
    </div>
  </section>

