<script>
(function () {
  "use strict";

  var ROOMS = {
    "standard": {
      name: "Standard Room",
      tag: "Standard",
      capacity: "2 Guests",
      bed: "1 Queen Bed",
      size: "Comfortable, well-proportioned room",
      description: "A comfortable, well-furnished room suited to solo travellers and couples visiting Kabba. The Standard Room offers a restful night's sleep with all the essentials taken care of.",
      amenities: ["Air conditioning", "Free Wi-Fi", "Flat-screen TV", "Private bathroom", "Wardrobe", "Daily housekeeping"],
      images: [
        "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1595576508898-0ad5c879a061?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1584132967334-10e028bd69f7?auto=format&fit=crop&w=1200&q=80"
      ]
    },
    "deluxe": {
      name: "Deluxe Room",
      tag: "Deluxe",
      capacity: "2–3 Guests",
      bed: "1 King Bed",
      size: "Extra space and upgraded furnishing",
      description: "Extra room to relax, with upgraded furnishing for business or leisure guests. The Deluxe Room includes a comfortable seating nook and a work-friendly desk.",
      amenities: ["Air conditioning", "Free Wi-Fi", "Flat-screen TV", "Work desk", "Wardrobe", "Private bathroom", "Tea/coffee tray"],
      images: [
        "https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1560185127-6ed189bf02f4?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1560185893-a55cbc8c57e8?auto=format&fit=crop&w=1200&q=80"
      ]
    },
    "executive": {
      name: "Executive Room",
      tag: "Executive",
      capacity: "2–3 Guests",
      bed: "1 King Bed",
      size: "Refined furnishing with a seating area",
      description: "A refined room with a dedicated seating and work area for the discerning guest — well suited to longer business stays in Kabba.",
      amenities: ["Air conditioning", "Free Wi-Fi", "Smart TV", "Seating area", "Mini fridge", "Work desk", "Premium toiletries"],
      images: [
        "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&w=1200&q=80"
      ]
    },
    "royal-suite": {
      name: "Royal Suite",
      tag: "Suite",
      capacity: "2–4 Guests",
      bed: "1 King Bed + Sofa Bed",
      size: "Our most spacious accommodation",
      description: "Our most spacious accommodation, with a separate living area for a truly royal stay — ideal for guests hosting visitors or celebrating a special occasion.",
      amenities: ["Air conditioning", "Free Wi-Fi", "Smart TV", "Separate living area", "Mini bar", "Premium toiletries", "Priority housekeeping"],
      images: [
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1584132915807-fd1f5fbc078f?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1519104179923-4a9d05a81c6a?auto=format&fit=crop&w=1200&q=80"
      ]
    }
  };

  var params = new URLSearchParams(window.location.search);
  var key = params.get("room");
  var room = ROOMS[key] || ROOMS["standard"];

  document.getElementById("page-title").textContent = room.name + " | Golden Grand Royal Hotel Kabba";
  document.getElementById("room-name").textContent = room.name;
  document.getElementById("crumb-room").textContent = room.name;
  document.getElementById("room-description").textContent = room.description;
  document.getElementById("room-main-img").src = room.images[0];
  document.getElementById("room-main-img").alt = room.name + " at Golden Grand Royal Hotel, Kabba";

  document.getElementById("room-meta").innerHTML =
    '<span><i class="fa-solid fa-user"></i>' + room.capacity + '</span>' +
    '<span><i class="fa-solid fa-bed"></i>' + room.bed + '</span>';

  var amenitiesEl = document.getElementById("room-amenities");
  room.amenities.forEach(function (a) {
    var li = document.createElement("li");
    li.innerHTML = '<i class="fa-solid fa-circle-check"></i> ' + a;
    amenitiesEl.appendChild(li);
  });

  var thumbsEl = document.getElementById("room-thumbs");
  room.images.forEach(function (src, i) {
    var img = document.createElement("img");
    img.src = src;
    img.alt = room.name + " view " + (i + 1);
    if (i === 0) img.className = "active";
    thumbsEl.appendChild(img);
  });

  var waMsg = "Hello Golden Grand Royal Hotel, I would like to ask about the " + room.name + ".";
  document.getElementById("room-whatsapp-link").setAttribute("data-whatsapp", waMsg);
  document.getElementById("room-whatsapp-link").addEventListener("click", function (e) {
    e.preventDefault();
    window.openWhatsApp ? window.openWhatsApp(waMsg) : null;
  });

  var otherRoomsEl = document.getElementById("other-rooms");
  Object.keys(ROOMS).forEach(function (k) {
    if (k === key || (k === "standard" && !key)) return;
    var r = ROOMS[k];
    var card = document.createElement("div");
    card.className = "card reveal";
    card.innerHTML =
      '<div class="card-media"><img src="' + r.images[0] + '" alt="' + r.name + '" loading="lazy"><span class="card-tag">' + r.tag + '</span></div>' +
      '<div class="card-body"><h3>' + r.name + '</h3><p>' + r.capacity + ' &middot; ' + r.bed + '</p>' +
      '<div class="card-actions"><a href="room-details.html?room=' + k + '" class="btn btn-navy btn-sm">View Room</a></div></div>';
    otherRoomsEl.appendChild(card);
  });
})();
</script>
