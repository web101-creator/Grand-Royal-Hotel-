    <div class="container hero-inner">
      <span class="section-eyebrow">Welcome to</span>
      <h1>Golden Grand Royal Hotel</h1>
      <p class="tagline">Experience Comfort. Luxury. Hospitality.</p>
      <p class="lead">Your comfortable destination for relaxation, accommodation, events and unforgettable hospitality in Kabba, Kogi State.</p>
      <div class="hero-ctas">
        <a href="booking.html" class="btn btn-gold">Book a Room</a>
        <a href="rooms.html" class="btn btn-outline">Explore Our Rooms</a>
      </div>
    </div>
  </section>

  <!-- BOOKING SEARCH BAR -->
  <div class="container booking-bar">
    <form class="booking-card" id="availability-form" aria-label="Check room availability">
      <div class="field">
        <label for="s-checkin">Check-in</label>
        <input type="date" id="s-checkin" name="checkin" required>
      </div>
      <div class="field">
        <label for="s-checkout">Check-out</label>
        <input type="date" id="s-checkout" name="checkout" required>
      </div>
      <div class="field">
        <label for="s-adults">Adults</label>
        <select id="s-adults" name="adults">
          <option>1</option><option selected>2</option><option>3</option><option>4+</option>
        </select>
      </div>
      <div class="field">
        <label for="s-children">Children</label>
        <select id="s-children" name="children">
          <option selected>0</option><option>1</option><option>2</option><option>3+</option>
        </select>
      </div>
      <div class="field">
        <label for="s-roomtype">Room Type</label>
        <select id="s-roomtype" name="roomtype">
          <option value="">Any</option>
          <option>Standard Room</option>
          <option>Deluxe Room</option>
          <option>Executive Room</option>
          <option>Royal Suite</option>
        </select>
      </div>
      <div class="field field-btn">
        <button type="submit" class="btn btn-navy btn-block">Check Availability</button>
      </div>
    </form>
    <p class="booking-msg" id="availability-msg" role="status"></p>
  </div>

