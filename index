            <div class="card-price">Contact hotel for current rate</div>
            <div class="card-actions">
              <a href="room-details.html?room=standard" class="btn btn-navy btn-sm">View Room</a>
            </div>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-media">
            <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=600&q=80" alt="Deluxe Room at Golden Grand Royal Hotel" loading="lazy">
            <span class="card-tag">Deluxe</span>
          </div>
          <div class="card-body">
            <h3>Deluxe Room</h3>
            <p>Extra space and comfort, ideal for business or leisure travellers.</p>
            <div class="card-price">Contact hotel for current rate</div>
            <div class="card-actions">
              <a href="room-details.html?room=deluxe" class="btn btn-navy btn-sm">View Room</a>
            </div>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-media">
            <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=600&q=80" alt="Executive Room at Golden Grand Royal Hotel" loading="lazy">
            <span class="card-tag">Executive</span>
          </div>
          <div class="card-body">
            <h3>Executive Room</h3>
            <p>Refined furnishing and a dedicated work area for the discerning guest.</p>
            <div class="card-price">Rates available on request</div>
            <div class="card-actions">
              <a href="room-details.html?room=executive" class="btn btn-navy btn-sm">View Room</a>
            </div>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-media">
            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80" alt="Royal Suite at Golden Grand Royal Hotel" loading="lazy">
            <span class="card-tag">Suite</span>
          </div>
          <div class="card-body">
            <h3>Royal Suite</h3>
            <p>Our most spacious suite, designed for a truly royal stay.</p>
            <div class="card-price">Rates available on request</div>
            <div class="card-actions">
              <a href="room-details.html?room=royal-suite" class="btn btn-navy btn-sm">View Room</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
